# ===== App =====
ENV=development
# Public base URL used for telephony webhooks (e.g. an ngrok HTTPS URL in dev).
SERVER_URL=https://your-ngrok-subdomain.ngrok-free.app
# Comma-separated browser origins allowed to call the API (the dashboard).
# Set your deployed frontend URL here in production. Defaults cover local dev.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public dashboard URL. MUST match the origin you actually open the dashboard on,
# because password-reset / team-invite links are built from it — if it points at
# the wrong port, those emailed links open a dead page. Dev server runs on :3000
# (see frontend/package.json); set your real domain in production.
APP_BASE_URL=http://127.0.0.1:3000

# ===== Database (Supabase Postgres) =====
# Configure EITHER DATABASE_URL (full URI) OR the DB_* parts below.
# Find these in the Supabase dashboard: Connect > Direct connection / pooler.
# Prefer the DB_* parts: the password is used as-is (no URL-encoding needed),
# so special characters like @ and # are fine. DATABASE_URL wins if non-empty.
DATABASE_URL=
DB_USER=postgres.your_supabase_project_ref
DB_PASSWORD="your_db_password"
DB_HOST=aws-1-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres

# ===== Auth =====
# REQUIRED in production: a long, random secret (32+ chars). The app falls back
# to an insecure built-in default when this is empty, which would let anyone mint
# valid session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate_a_long_random_secret
# How long a dashboard session lasts. Was a hardcoded 7 days — a long window for a
# stolen token. Sessions can now be revoked before expiry (users.token_version is
# bumped by password change, "log out everywhere", and suspension), so this is a
# ceiling rather than the only control. 1440 = 24h. Raise it if daily sign-in is too
# much friction; refresh-token rotation is the follow-up that removes the tradeoff.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Platform super-admins (comma-separated emails). These accounts can open the
# dashboard Admin page to assign plans / custom call allowances for any client.
# Set this to your own login email. Everyone else is denied (403).
SUPERADMIN_EMAILS=

# ===== Email (SMTP) =====
# For password reset + team invites. Leave SMTP_HOST empty in dev to log links
# to the server instead of sending real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# ===== Supabase Auth — Google sign-in ONLY =====
# Supabase Auth is used purely as a Google identity provider. It does NOT replace
# this app's authentication: password sign-up, login, email verification, password
# reset, session revocation, per-account lockout, suspension and the audit trail all
# stay in `public.users` and backend/routes/auth.py, and all are test-covered.
#
# Flow: browser completes Google sign-in with Supabase -> sends the Supabase token to
# POST /api/auth/oauth/google -> backend verifies it against Supabase and returns
# THIS app's own session token. Everything downstream is unchanged.
#
# Leave these empty and the app behaves exactly as before: the "Continue with Google"
# button is not rendered and the endpoint returns 503.
#
# SUPABASE_URL is optional — it is derived from DB_USER (`postgres.<project-ref>`)
# when unset, so it cannot drift from the database the app points at.
SUPABASE_URL=
# The ANON (public) key, from Supabase dashboard -> Project Settings -> API.
SUPABASE_ANON_KEY=
#
# !! NEVER add the SERVICE ROLE key to this file's frontend section or to any
# !! VITE_-prefixed variable. It bypasses Row Level Security completely and Vite
# !! inlines VITE_ variables into the public JavaScript bundle. The backend does not
# !! need it either — token verification uses the anon key.
#
# The frontend needs the same two values under VITE_ names, in frontend/.env.local
# (that file is gitignored; do not put them in frontend/.env, which is not):
#   VITE_SUPABASE_URL=https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<anon key>
#
# Supabase dashboard setup, both required or the redirect fails:
#   Authentication -> Providers -> Google: enable, paste the Google OAuth client
#     id/secret from Google Cloud Console.
#   Authentication -> URL Configuration -> Redirect URLs: add
#     http://127.0.0.1:3000/auth/callback   (local)
#     https://<your-domain>/auth/callback   (production)
#   In Google Cloud Console the authorised redirect URI is Supabase's callback:
#     https://<project-ref>.supabase.co/auth/v1/callback

# ===== Redis =====
# NOTE: currently read by settings.py and used by NOTHING else — Redis is not on
# any request path yet. It is kept for the two items that need it: moving rate
# limiting off in-memory storage (so limits survive a restart and apply across
# replicas) and moving the notification event bus to pub/sub (so running more than
# one API replica stops breaking notifications and duplicating reminders).
REDIS_URL=redis://localhost:6379/0
# REQUIRED BY docker-compose.yml. Compose refuses to start without it, on purpose:
# Redis used to be published on port 6379 with no password at all, which on a host
# with a public IP is an open Redis. It is no longer published to the host either.
# docker-compose overrides REDIS_URL to include this password automatically.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# ===== MiniMax (LLM + TTS) =====
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_GROUP_ID=your_minimax_group_id
# International base by default; change for mainland-China accounts.
MINIMAX_API_BASE=https://api.minimax.io/v1
# TTS language hint for correct pronunciation (Hindi / English / auto).
MINIMAX_LANGUAGE_BOOST=Hindi

# ===== Speech-to-Text (ASR) — Deepgram =====
# MiniMax has no STT. Create a key at https://console.deepgram.com/.
# Leave DEEPGRAM_API_KEY empty to keep STT in mock mode.
DEEPGRAM_API_KEY=
# nova-2 supports Hindi; language "hi" for Hindi-speaking callers.
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=hi

# ===== Vobiz (Indian calling) =====
# SIP trunk credentials (SIP connection / outbound). These are the SIP
# username/password from your Vobiz trunk — NOT the REST API keys below.
VOBIZ_SIP_DOMAIN=
VOBIZ_USERNAME=
VOBIZ_PASSWORD=
VOBIZ_OUTBOUND_NUMBER=
# Vobiz REST API credentials — REQUIRED for one-click number provisioning
# (search + buy a DID and route it, from the dashboard). These are SEPARATE from
# the SIP username/password above. Get them from the Vobiz dashboard's API /
# Developer / Account section (an "Auth ID" and an "Auth Token").
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# Vobiz inbound TRUNK id that points at your LiveKit SIP URI (e.g.
# <project>.sip.livekit.cloud). Vobiz does NOT auto-route new numbers: each DID
# must be assigned to a trunk via
#   PATCH /api/v1/Account/{auth_id}/numbers/{number}/assign  {"trunk_group_id": ...}
# One trunk serves ALL numbers, so this is a single one-time value that the
# provisioning flow reuses for every client's DID.
VOBIZ_TRUNK_GROUP_ID=

# ===== Call quota enforcement =====
# When true, inbound calls beyond a tenant's monthly allowance are answered with
# QUOTA_EXCEEDED_MESSAGE and ended. Default false (calls are never blocked), and
# the check is fail-open (any error while checking lets the call through).
ENFORCE_CALL_QUOTA=false
QUOTA_EXCEEDED_MESSAGE=Sorry, we are unable to take your call at the moment. Please try again later.

# ===== Payments (Razorpay) =====
# Self-serve plan upgrades via Razorpay Checkout. Leave blank to keep payments
# off — the dashboard then shows "Request upgrade" instead of a pay button.
# Use rzp_test_* keys while testing. KEY_ID is sent to the browser (public);
# KEY_SECRET and WEBHOOK_SECRET must stay server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: set this and add a webhook (URL: <SERVER_URL>/api/billing/webhook,
# event: payment.captured) in the Razorpay dashboard for reliable confirmation.
RAZORPAY_WEBHOOK_SECRET=

# ===== WhatsApp (Meta Cloud API) — appointment confirmations + reminders =====
# Official Meta WhatsApp Cloud API. These are the PLATFORM-LEVEL DEFAULTS / fallback:
# each client can set their OWN WhatsApp number + token + templates in the dashboard
# (Agent Setup > WhatsApp), which override these. Leave everything blank to keep
# WhatsApp off unless a tenant configures its own. Get platform values from
# Meta Business Manager > WhatsApp > API setup.
# Proactive messages must use PRE-APPROVED templates. Create two templates whose
# body has exactly three variables in this order:
#   {{1}} = customer name, {{2}} = business name, {{3}} = date/time
# e.g. "Hello {{1}}, your appointment at {{2}} is confirmed for {{3}}."
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_VERSION=v22.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Must match your approved templates' language code (e.g. en_US or hi).
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_CONFIRM_TEMPLATE=appointment_confirmation
WHATSAPP_REMINDER_TEMPLATE=appointment_reminder
# Send the reminder once the appointment is within this many minutes (120 = 2h).
WHATSAPP_REMINDER_LEAD_MIN=120
# How often the reminder worker polls for due reminders (seconds).
WHATSAPP_REMINDER_INTERVAL_SEC=300

# ===== LiveKit (voice agent SIP bridge) =====
# Used ONLY by the separate LiveKit voice agent (agent/main.py), NOT the FastAPI
# backend. Create a project at https://cloud.livekit.io and copy these from
# Project Settings > Keys. LIVEKIT_URL looks like wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional overrides for the agent's behaviour (Hindi defaults are built in).
AGENT_SYSTEM_PROMPT=
AGENT_GREETING=
# REQUIRED for the agent to save bookings to the dashboard: a shared secret the
# agent sends to the backend, and it now unlocks exactly ONE endpoint:
# POST /api/calls/agent-context. That call resolves the clinic from the dialed
# number and hands the agent a short-lived token scoped to (clinic, call); every
# other /api/calls/agent-* endpoint requires that token instead.
#
# Why: this used to be a single shared secret across nine endpoints that each read
# `clinic_id` out of the request body — so one secret was effectively a master key
# over every client's data (read any tenant's prompt + knowledge base, write
# bookings into any tenant, append transcript to any call).
#
# REQUIRED. There is no fallback any more: it used to fall back to JWT_SECRET,
# which silently reused the session-signing key as an API credential. Must NOT be
# the same value as JWT_SECRET — startup refuses in production if it is.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_INTERNAL_SECRET=
# Lifetime of that per-call token. Must outlast a real conversation (a token
# expiring mid-call would break booking) while staying short enough that a leaked
# one is near-useless. Minimum 5.
AGENT_CALL_TOKEN_TTL_MIN=45
# Where the agent reaches the FastAPI backend (default is fine for local runs).
AGENT_BACKEND_URL=http://127.0.0.1:8000
# Optional model/voice overrides for the agent:
#   MINIMAX_LLM_MODEL  - default MiniMax-Text-01 (non-reasoning, fast, no <think>).
#   MINIMAX_TTS_VOICE  - default Calm_Woman. Others: Wise_Woman, Friendly_Person,
#                        Patient_Man, Deep_Voice_Man.
#   MINIMAX_TTS_MODEL  - default speech-02-turbo.
MINIMAX_LLM_MODEL=
MINIMAX_TTS_VOICE=

# ===== Gemini (LLM — PREFERRED for the voice agent) =====
# Free/paid key from https://aistudio.google.com. The agent picks its LLM in this
# order: Gemini -> Groq -> MiniMax, so setting this wins.
# Why Gemini: Groq's free tier allows only ~12k tokens/min, and this agent sends
# ~3.3k per turn (prompt + tools + knowledge base), so it hit 429s and went SILENT
# mid-call after a few turns. Gemini's quota is far higher.
# Model note: use a "-latest" alias — pinned ids like gemini-2.5-flash(-lite) return
# 404 for new keys. Measured against this agent's real payload (~1.8k-token prompt +
# 6 tools), time to first token: gemini-flash-lite-latest ~1.3s, gemini-flash-latest
# ~2.4s, gemini-2.0-flash / -flash-lite = 429 (not on this key).
# RELIABILITY: no single model is dependable. flash-lite is the fastest but has both
# hung and returned 503 "experiencing high demand" mid-call, which the caller hears as
# silence. The agent therefore runs an ordered FALLBACK CHAIN across PROVIDERS and
# switches instead of retrying a dead one.
#
# !! FREE-TIER WARNING (measured on a live call) !!
# A key without billing enabled is capped at 5 requests/MINUTE:
#   429 ... quota metric: generate_content_free_tier_requests, limit: 5,
#           model: gemini-3.6-flash
# A voice call uses 1-2 LLM requests per conversational turn, so a free key runs dry
# after ~3 turns and the caller hears silence. Enable billing on the Google Cloud
# project (or make Groq the primary via AGENT_LLM_ORDER below).
# Both "-latest" aliases resolve to the same model family on the SAME project, so they
# SHARE that quota — two Gemini entries is not real redundancy. GEMINI_FALLBACK_MODEL
# is therefore empty by default; only set it once the project is on a paid tier.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=
# Give up on the current provider after this many seconds and try the next one.
# Must exceed a healthy slow response (flash-latest can take ~3s) but stay well under
# what a caller will tolerate as silence.
AGENT_LLM_ATTEMPT_TIMEOUT=6
# Provider order for the fallback chain. The FIRST one serves the call, so it should be
# the one with real quota — if it is rate-limited, every turn burns a failed attempt
# (up to AGENT_LLM_ATTEMPT_TIMEOUT of silence) before failing over.
#   gemini,groq,minimax  - default; best when Gemini billing is enabled
#   groq,gemini,minimax  - use while Gemini is on the free tier (Groq is also the
#                          fastest: ~0.5s to first token vs Gemini's ~1.3-3s)
AGENT_LLM_ORDER=gemini,groq,minimax
# Pin ONE provider with no failover (gemini | groq | minimax), for A/B testing a
# provider on real calls without deleting keys. Overrides AGENT_LLM_ORDER. Empty = off.
AGENT_LLM_PROVIDER=
# MiniMax stays in the chain as the final failover even when Gemini/Groq are configured,
# because its quota is separate — it is the only thing left when both of those are
# rate-limited at once. Set to 0 to drop it (its tool-calling is less reliable).
AGENT_MINIMAX_LAST_RESORT=1

# ===== Groq (LLM — part of the fallback chain; see AGENT_LLM_ORDER above) =====
# Free API key at https://console.groq.com (starts with gsk_). TTS always stays
# MiniMax, so a cloned voice is unaffected by the LLM choice.
# Free tier is ~12k tokens/min and this agent sends ~3.3k per turn, so it 429s after
# 3-4 turns — set AGENT_PREEMPTIVE=0 (below) to halve that, or use a paid tier.
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ===== Voice agent tuning (all optional; sane defaults are in agent/main.py) =====
# TTS loudness. Applied AFTER synthesis via a soft-knee limiter, so speech gets
# louder while peaks stay clean (a plain multiply clipped and sounded "cut").
# Raise toward ~3.0 if callers say it's quiet; lower to ~1.5 if it sounds harsh.
MINIMAX_TTS_GAIN=2.0
MINIMAX_TTS_VOL=1.0
MINIMAX_TTS_SPEED=1.0
# TTS model. speech-2.8-turbo is the current Turbo tier and costs the SAME
# ($60 / 1M characters) as the legacy 2.6 / 02 models, while sounding more human.
MINIMAX_TTS_MODEL=speech-2.8-turbo
# Emotional delivery for speech-2.5+ / 2.8: happy | neutral | sad | angry ...
# Leave EMPTY when using an older TTS model (they reject/ignore this field).
MINIMAX_TTS_EMOTION=happy

# ----- TTS audio cache (cost saver) -----
# TTS bills per CHARACTER, and some lines are identical on every call (the
# greeting, the silence hang-up line). Caching their audio means paying for them
# once instead of once per call (~Rs 0.44/call for a typical greeting).
# 1 = on. Cached in RAM *and* on disk; the disk tier is what makes this work on
# Windows, where the worker process is recycled after every call.
AGENT_TTS_CACHE=1
# Where the audio files live. Empty => RAM-only (no disk tier). Git-ignored.
AGENT_TTS_CACHE_DIR=
# Only cache lines up to this many characters (long replies are unique anyway).
AGENT_TTS_CACHE_MAXCHARS=160
# In-memory entry cap, and the on-disk size cap in MB (LRU-pruned).
AGENT_TTS_CACHE_MAXENTRIES=64
AGENT_TTS_CACHE_DISK_MB=200
# Turn-taking. Lower = snappier replies, but too low makes the agent cut callers
# off mid-sentence. These were tuned against real call logs.
AGENT_MIN_ENDPOINTING=0.4
AGENT_MAX_ENDPOINTING=1.0
AGENT_VAD_MIN_SILENCE=0.4
# Hang up after this many seconds of caller silence.
AGENT_SILENCE_HANGUP_SEC=10
# Windows only: LiveKit's native layer can panic during call teardown, leaving the
# worker alive but unable to take the NEXT call. 1 = exit cleanly after each call
# so a supervisor/restart loop starts a fresh worker. Set 0 on Linux, where the
# panic doesn't occur and one warm worker serves many calls (lower latency).
AGENT_RECYCLE_AFTER_CALL=0
# Keep a job process pre-warmed so an incoming call isn't waiting for one to spawn.
AGENT_IDLE_PROCESSES=1
# Speculative generation: starts the LLM before the caller has finished speaking, so
# the reply is ready sooner. It costs a SECOND LLM request per turn, which on a free
# tier is what actually exhausts the quota (Gemini free = 5 requests/min => ~2 turns).
# Set 0 whenever the primary provider is on a free tier; keep 1 on a paid tier.
AGENT_PREEMPTIVE=1
